# ==============================================================================
# .gitignore — Python Mastery Curriculum
# ==============================================================================

# --- IDEs & Editors ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/
.python-version

# --- Python Bytecode & Caches ---
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Packaging & Build Artifacts ---
build/
dist/
*.egg-info/
*.egg

# --- Runtime Outputs, Logs & Local Databases (Generated by Lessons) ---
sample_workspace/
*.log
*.db
*.sqlite
*.sqlite3

# --- Environment Variables & Secrets ---
.env
.env.*
!.env.example

# --- OS-Specific Junk Files ---
.DS_Store
Thumbs.db
desktop.ini